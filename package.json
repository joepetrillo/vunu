{
  "name": "vunu",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''; simple-git-hooks",
    "lint": "svelte-kit sync && oxfmt --check && eslint .",
    "format": "oxfmt",
    "fix": "oxfmt && eslint --fix .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun run test:unit --run && bun run test:e2e",
    "test:unit": "vitest",
    "test:e2e": "playwright install chromium && playwright test",
    "verify": "bun install --frozen-lockfile && bun run lint && bun run check && bun run test:unit --run",
    "outdated:next": "bun scripts/outdated-next.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "bun scripts/migrate-test-db.ts",
    "db:seed": "bun scripts/seed-movies.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@vercel/functions": "^3.9.9",
    "better-auth": "^1.7.7",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.23.1",
    "resend": "^6.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-vercel": "7.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@vitest/browser-playwright": "^5.0.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "oxfmt": "^0.71.0",
    "playwright": "^1.60.0",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^5.0.2",
    "vitest-browser-svelte": "^3.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint"
  },
  "engines": {
    "node": "24.x"
  }
}
